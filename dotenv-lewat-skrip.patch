diff --git a/load-env.sh b/load-env.sh
new file mode 100644
index 0000000..e6e21a4
--- /dev/null
+++ b/load-env.sh
@@ -0,0 +1,14 @@
+if [ -f .env ]; then
+  while IFS= read -r line || [ -n "$line" ]; do
+    case "$line" in
+      ''|'#'*) continue ;;
+    esac
+    key=${line%%=*}
+    value=${line#*=}
+    case "$key" in
+      ''|[0-9]*|*[!A-Za-z0-9_]*) continue ;;
+    esac
+    eval "current=\${$key:-}"
+    [ -n "$current" ] || export "$key=$value"
+  done < .env
+fi

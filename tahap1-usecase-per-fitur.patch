@@ -0,0 +1,19 @@
+package pagination
+
+const (
+	defaultLimit = 20
+	maxLimit     = 100
+)
+
+func Normalize(limit, offset int) (int, int) {
+	if limit <= 0 {
+		limit = defaultLimit
+	}
+	if limit > maxLimit {
+		limit = maxLimit
+	}
+	if offset < 0 {
+		offset = 0
+	}
+	return limit, offset
+}
